{
  "id": "potplayer",
  "name": "PotPlayer",
  "app": "potplayer",
  "version": 2,
  "notes": "PotPlayer default hotkeys. A hold = next subtitle track (Alt+L). Player page: subs on/off (Alt+H), aspect ratio cycle (Ctrl+F6), aspect reset (Ctrl+F5).",
  "actions": {
    "playPause": {
      "key": "Space",
      "label": "Play/Pause"
    },
    "seekBack": {
      "key": "ArrowLeft",
      "label": "-30s",
      "mods": [
        "Control"
      ]
    },
    "seekFwd": {
      "key": "ArrowRight",
      "label": "+30s",
      "mods": [
        "Control"
      ]
    },
    "seekBackSmall": {
      "key": "ArrowLeft",
      "label": "-5s"
    },
    "seekFwdSmall": {
      "key": "ArrowRight",
      "label": "+5s"
    },
    "volUp": {
      "key": "ArrowUp",
      "label": "Vol +"
    },
    "volDown": {
      "key": "ArrowDown",
      "label": "Vol -"
    },
    "mute": {
      "key": "KeyM",
      "label": "Mute"
    },
    "fullscreen": {
      "key": "Enter",
      "label": "Fullscreen"
    },
    "back": null,
    "showUI": {
      "key": "KeyL",
      "mods": [
        "Alt"
      ],
      "label": "Subs track"
    },
    "next": {
      "key": "PageDown",
      "label": "Next file"
    },
    "subSizeUp": null,
    "subSizeDown": null,
    "subDelayUp": {
      "key": "Period",
      "label": "Subs +"
    },
    "subDelayDown": {
      "key": "Comma",
      "label": "Subs -"
    },
    "subsToggle": {
      "key": "KeyH",
      "mods": [
        "Alt"
      ],
      "label": "Subs on/off"
    },
    "subsTrack": {
      "key": "KeyL",
      "mods": [
        "Alt"
      ],
      "label": "Subs track"
    },
    "aspect": {
      "key": "F6",
      "mods": [
        "Control"
      ],
      "label": "Aspect ratio"
    },
    "aspectReset": {
      "key": "F5",
      "mods": [
        "Control"
      ],
      "label": "Aspect reset"
    }
  }
}